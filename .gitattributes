* text=auto

# 跨平台文本统一使用 LF
*.md text eol=lf
*.txt text eol=lf
*.json text eol=lf
*.py text eol=lf
*.dart text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.xml text eol=lf
*.gradle text eol=lf
*.kts text eol=lf
*.kt text eol=lf
*.java text eol=lf
*.swift text eol=lf
*.sh text eol=lf

# Windows 脚本使用 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# 二进制成果不参与文本差异与换行转换
*.zip binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.pdf binary
*.docx binary
*.pptx binary
*.xlsx binary

# archive 保存外部原始资料和历史快照，不改写原始字节
archive/** -text !eol
