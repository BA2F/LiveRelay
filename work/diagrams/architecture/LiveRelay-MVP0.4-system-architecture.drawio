        <mxCell id="p08-verifyProof" value="6  Owner验签、匹配唯一挑战与7天期限；持久绑定并消费挑战" style="html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#287E77;fontColor=#287E77;fontFamily=Noto Sans CJK SC;fontSize=17;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" evidence="C10,D05">
