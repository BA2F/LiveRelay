          </mxGeometry>
        </mxCell>
        <mxCell id="p07-toolResult" value="6b  无网络 Bash；只读遮蔽输入；返回有限结果" style="html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#287E77;fontColor=#287E77;fontFamily=Noto Sans CJK SC;fontSize=17;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" evidence="C20,C35">
          <mxGeometry relative="1" as="geometry">
