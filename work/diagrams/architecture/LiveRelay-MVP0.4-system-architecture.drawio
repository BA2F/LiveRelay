            <mxPoint x="0" y="-13" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="p07-response" value="7  cards JSON → Schema／Token 校验 → 本机回填" style="html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#287E77;fontColor=#287E77;fontFamily=Noto Sans CJK SC;fontSize=17;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" evidence="C18,C35">
          <mxGeometry relative="1" as="geometry">
