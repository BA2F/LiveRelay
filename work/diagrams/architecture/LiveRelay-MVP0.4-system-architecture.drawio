            <mxPoint x="0" y="-13" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="p07-draft" value="8  显示建议；本人确认后保存 LifeCard 草稿与来源" style="html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#287E77;fontColor=#287E77;fontFamily=Noto Sans CJK SC;fontSize=17;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" evidence="C19,C16">
