        <mxCell id="p08-recipientKey" value="&lt;div style=&quot;font-size:22px;font-weight:bold;line-height:1.25&quot;&gt;Recipient 身份可独立备份&lt;/div&gt;&lt;div style=&quot;font-size:18px;line-height:1.5;margin-top:10px&quot;&gt;自有密码经 Argon2id 保护 .lridentity；RecoverableFile 写入。加密身份备份可以在另一独立目录恢复；不含 Owner VMK。&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontFamily=Noto Sans CJK SC;fontSize=19;fontColor=#263D4B;spacing=14;rounded=1;arcSize=12;align=left;verticalAlign=middle;fillColor=#F7F9FB;strokeColor=#D8E0E8;strokeWidth=2;" vertex="1" parent="1" evidence="C13,D05">
          <mxGeometry x="635" y="840" width="530" height="150" as="geometry" />
        </mxCell>
        <mxCell id="p08-identityLimits" value="&lt;div style=&quot;font-size:22px;font-weight:bold;line-height:1.25&quot;&gt;本机信任边界与回退限制&lt;/div&gt;&lt;div style=&quot;font-size:18px;line-height:1.5;margin-top:10px&quot;&gt;切换接收入口先锁 Owner。无私钥及备份不能按名称找回；本机 sequence 不具硬件单调性，不宣称抗设备回滚。&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontFamily=Noto Sans CJK SC;fontSize=19;fontColor=#263D4B;spacing=14;rounded=1;arcSize=12;align=left;verticalAlign=middle;fillColor=#FFF4E3;strokeColor=#D18A32;strokeWidth=2;" vertex="1" parent="1" evidence="C29,D05">
