        <mxCell id="p07-request" value="5  HTTPS：获准文本／模型／协议；敏感行仅发 Token" style="html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#287E77;fontColor=#287E77;fontFamily=Noto Sans CJK SC;fontSize=17;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" evidence="C17,C35">
