          </mxGeometry>
        </mxCell>
        <mxCell id="p08-ownerKey" value="&lt;div style=&quot;font-size:22px;font-weight:bold;line-height:1.25&quot;&gt;Owner 私钥与持久状态&lt;/div&gt;&lt;div style=&quot;font-size:18px;line-height:1.5;margin-top:10px&quot;&gt;身份双钥／profile／recipient绑定／sequence 在 schema v5 加密 local_state 内。改显示名称或换日常密码不改变身份指纹。&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontFamily=Noto Sans CJK SC;fontSize=19;fontColor=#263D4B;spacing=14;rounded=1;arcSize=12;align=left;verticalAlign=middle;fillColor=#F7F9FB;strokeColor=#D8E0E8;strokeWidth=2;" vertex="1" parent="1" evidence="C10,C14,D05">
