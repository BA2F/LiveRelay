            <mxPoint x="220" y="786" as="targetPoint" />
            <mxPoint x="0" y="-13" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="p07-guard" value="&lt;div style=&quot;font-size:22px;font-weight:bold;line-height:1.25&quot;&gt;取消／锁定与安全配置&lt;/div&gt;&lt;div style=&quot;font-size:18px;line-height:1.5;margin-top:10px&quot;&gt;锁定取消任务并丢弃结果；命令会话 finally 关闭。API Key 来自系统安全存储；Provider 没有仓储、原件或 VMK 入口。&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontFamily=Noto Sans CJK SC;fontSize=19;fontColor=#263D4B;spacing=14;rounded=1;arcSize=12;align=left;verticalAlign=middle;fillColor=#F7F9FB;strokeColor=#D8E0E8;strokeWidth=2;" vertex="1" parent="1" evidence="C17,C27,C19">
          <mxGeometry x="60" y="880" width="1025" height="113" as="geometry" />
        </mxCell>
        <mxCell id="p07-gap" value="&lt;div style=&quot;font-size:22px;font-weight:bold;line-height:1.25&quot;&gt;已知后置缺口：Credential 录入／转换&lt;/div&gt;&lt;div style=&quot;font-size:18px;line-height:1.5;margin-top:10px&quot;&gt;Agent 仅保存 LifeCard；正文中的回填密码不是 Secret 字段，会进入通用预览／搜索。尚未贯通密码类型候选与转换。&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontFamily=Noto Sans CJK SC;fontSize=19;fontColor=#263D4B;spacing=14;rounded=1;arcSize=12;align=left;verticalAlign=middle;fillColor=#FFF4E3;strokeColor=#D18A32;strokeWidth=2;" vertex="1" parent="1" evidence="D08,C19">
          <mxGeometry x="1130" y="880" width="610" height="113" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
